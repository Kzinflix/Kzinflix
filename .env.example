# Base do site. Cadastre estes endereços como redirect/callback nos provedores.
APP_BASE_URL=http://localhost:8000

# Modo local para testar publicações em localhost sem login OAuth.
# O servidor aceita esse modo apenas em conexões loopback e sem OAuth configurado.
LOCAL_DEV_MODE=1

# Google Identity Services: Console do Google Cloud > Credenciais > ID do cliente OAuth (app da Web)
GOOGLE_CLIENT_ID=

# Discord OAuth: Developer Portal > sua aplicação > OAuth2 > Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# E-mails que podem publicar obras. Separe mais de um por vírgula.
ADMIN_EMAILS=

# No Render, aponte ambos para o disco persistente montado em /var/data.
KZIN_DATA_DIR=./data
KZIN_UPLOADS_DIR=./uploads
